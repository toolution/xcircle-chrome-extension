{
  "manifest_version": 3,
  "name": "XCircle — X/Twitter Interaction Circle",
  "short_name": "XCircle",
  "version": "1.0.0",
  "description": "See who you talk with most on X. Generate, customize, download and share your interaction circle. Powered by xcircle.me.",
  "homepage_url": "https://xcircle.me",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open XCircle",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "contextMenus", "activeTab", "tabs"],
  "host_permissions": [
    "https://xcircle.me/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://pbs.twimg.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open XCircle side panel"
    }
  }
}
